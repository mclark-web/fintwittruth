# SQLite path. The Prisma CLI resolves this relative to prisma/schema.prisma.
# Runtime access uses an absolute path in src/lib/prisma.ts.
DATABASE_URL="file:./fintwittruth.db"

# demo (default) keeps the demo banner. Set to live only after a real feed replaces the seed.
NEXT_PUBLIC_DATA_MODE="demo"

# Optional public origin for metadata. Example: https://example.com
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Future licensed feed. Unset means the demo adapters stay in place.
# FEED_PROVIDER="demo"
# X_BEARER_TOKEN=""
# MARKET_DATA_PROVIDER="demo"
