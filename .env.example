# SQLite path. The Prisma CLI resolves this relative to prisma/schema.prisma.
# Runtime access uses an absolute path in src/lib/prisma.ts.
DATABASE_URL="file:./fintwittruth.db"

# demo (default) keeps the demo banner. Set to live only after a real feed replaces the seed.
NEXT_PUBLIC_DATA_MODE="demo"

# Optional public origin for metadata. Example: https://example.com
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Future licensed feed. Unset means the demo adapters stay in place.
# FEED_PROVIDER="demo"
# X_BEARER_TOKEN=""
# MARKET_DATA_PROVIDER="demo"

# Operator intake. A long random string. Required before /admin will accept a paste.
# ADMIN_TOKEN=""

# Persistent intake book on Vercel. Create a Blob store and connect it so this is set.
# Without it, Vercel refuses to save pastes. Local dev writes data/intake-book.json instead.
# BLOB_READ_WRITE_TOKEN=""

# Optional. When set, an ambiguous paste can ask xAI for a suggestion. Nothing is graded from it.
# XAI_API_KEY=""
# XAI_MODEL="grok-3"

# Optional. When set, the dispute page also offers this mailbox. Leave unset to keep the on-site form only.
# DISPUTE_EMAIL=""
