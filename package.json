{
  "name": "fintwittruth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma db push --accept-data-loss && prisma db seed && next dev",
    "build": "tsx --test src/lib/scoring.test.ts src/lib/dataset.test.ts && prisma generate && prisma db push --accept-data-loss && prisma db seed && next build",
    "start": "next start",
    "db:seed": "prisma db seed",
    "test": "tsx --test src/lib/scoring.test.ts src/lib/dataset.test.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
