{
  "name": "fintwittruth",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/ensure-db.ts",
    "prebuild": "prisma generate && prisma db push --skip-generate --accept-data-loss && tsx prisma/seed.ts",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --accept-data-loss && tsx prisma/seed.ts",
    "test": "tsx --test src/lib/scoring.test.ts src/lib/grades.test.ts src/lib/dataset.test.ts src/lib/board.test.ts src/lib/brand-lock.test.ts src/lib/ingest.test.ts src/lib/yahoo.test.ts",
    "ingest": "tsx scripts/ingest-call.ts",
    "accuracy": "tsx scripts/accuracy-guard.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
